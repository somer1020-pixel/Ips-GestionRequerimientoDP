@page "/historico"
@attribute [Authorize(Policy = Policies.Lider)]
@inherits AppPage
@inject IKpiService Kpi
@inject IUsuarioService Users

<PageTitle>Histórico · @AppInfo.Nombre</PageTitle>

@if (_v is { } v)
{
    <section data-screen-label="Histórico" class="stack">
        <div class="page-head">
            <div>
                <h2 style="margin:0">Histórico</h2>
                <div class="sub">Cumplimiento por semana o mes. "A tiempo" = OK registrado el mismo día de entrega o antes.</div>
            </div>
            <div class="page-actions">
                <AnalystFilter Analysts="_analysts" Value="Ui.AnFilter" ValueChanged="SetAn" />
                <PeriodNav Value="_p" ValueChanged="SetPeriodo" />
                <button class="btn btn-outline-secondary" @onclick="@(() => Download($"export/historico?modo={(_p.Modo == PeriodoModo.Mes ? "mes" : "semana")}&ref={Fechas.Iso(_p.Desde)}{(Ui.AnFilter is { } a ? $"&analista={a}" : "")}"))"><Icon Name="download" />Descargar periodo</button>
            </div>
        </div>
        <div class="kpi-grid">
            @foreach (var k in v.Kpis)
            {
                <KpiCard K="k" />
            }
        </div>
        <div class="two-col">
            <div class="stack-3" style="min-width:0">
                <h4 style="margin:0">@(_p.Modo == PeriodoModo.Semana ? "Por día" : "Por semana")</h4>
                <div style="display:flex;flex-direction:column">
                    @foreach (var b in v.Buckets)
                    {
                        <div @onclick="() => PickBucket(b)" style="display:grid;grid-template-columns:minmax(110px,0.9fr) minmax(0,2fr) auto;gap:var(--space-3);align-items:center;padding:8px 0;border-top:1px solid var(--color-divider);font-size:13px;cursor:@(b.Week is null ? "default" : "pointer")">
                            <span style="white-space:nowrap;font-weight:500">@b.Label</span>
                            <div style="height:14px;background:var(--color-neutral-200)"><div style="height:100%;width:@P(b.Pct);background:var(--color-accent-200)"><div style="height:100%;width:@P(b.OkPct);background:var(--color-accent)"></div></div></div>
                            <span style="white-space:nowrap;color:var(--color-neutral-800)">@b.Stats.Ok/@b.Stats.N OK · @(b.Stats.Ok > 0 ? b.Stats.OtPct + "%" : "—") a tiempo · @b.Stats.Late atrasos</span>
                        </div>
                    }
                </div>
                <div style="display:flex;gap:var(--space-4);font-size:12px;color:var(--color-neutral-700)">
                    <span style="display:flex;align-items:center;gap:6px"><span style="width:10px;height:10px;background:var(--color-accent)"></span>Con OK</span>
                    <span style="display:flex;align-items:center;gap:6px"><span style="width:10px;height:10px;background:var(--color-accent-200)"></span>Abiertos</span>
                </div>
            </div>
            <div class="stack-3" style="min-width:0">
                <h4 style="margin:0">Por analista</h4>
                <div class="scroll-x">
                    <table class="table">
                        <thead><tr><th>Analista</th><th>DP</th><th>COD</th><th>Scripts</th><th>Horas</th><th>Registros</th><th>Con OK</th><th>A tiempo</th><th>Atrasos</th></tr></thead>
                        <tbody>
                            @foreach (var a in v.Analistas)
                            {
                                <tr @onclick="() => SetAn(Ui.AnFilter == a.Analista.Id ? null : a.Analista.Id)" style="cursor:pointer">
                                    <td style="white-space:nowrap;font-weight:500">@a.Analista.Nombre@(Ui.AnFilter == a.Analista.Id ? " ●" : "")</td>
                                    <td>@a.Dp</td><td>@a.Cod</td><td>@a.Sc</td>
                                    <td class="nowrap">@(a.Horas > 0 ? Reglas.FmtH(a.Horas) : "—")</td>
                                    <td class="nowrap">@(a.Registros > 0 ? Reglas.FmtN((long)a.Registros) : "—")</td>
                                    <td>@a.Stats.Ok/@a.Stats.N</td><td>@(a.Stats.Ok > 0 ? a.Stats.OtPct + "%" : "—")</td>
                                    <td style="font-weight:@(a.Stats.Late > 0 ? "700" : "400")">@a.Stats.Late</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="stack-3">
            <h4 style="margin:0">Entregables del periodo <span style="font-family:var(--font-body);font-weight:400;font-size:13px;color:var(--color-neutral-700)">@(v.Total > 100 ? $"· mostrando 100 de {v.Total} (descarga el periodo para ver todo)" : $"· {v.Total}")</span></h4>
            <div class="scroll-x">
                <table class="table">
                    <thead><tr><th>Día</th><th>Tipo</th><th>Job</th><th>Proyecto</th><th>Descripción</th><th>Analista</th><th>Estado</th><th>OK</th></tr></thead>
                    <tbody>
                        @foreach (var r in v.Lista)
                        {
                            var ot = Reglas.IsOnTime(r);
                            var late = Reglas.Atrasado(r, Today);
                            <tr @key="r.Id" @onclick="() => Ui.OpenDetail(r.Id)" style="cursor:pointer">
                                <DayCell R="r" Today="Today" MarkLate="false" Color="inherit" />
                                <td><span class="@Reglas.Tipo(r.Tipo).Css">@Reglas.Tipo(r.Tipo).Short</span></td>
                                <td class="job">@r.Job</td>
                                <td>@r.Proyecto</td>
                                <td>@r.Descripcion</td>
                                <td class="nowrap">@Name(r.AnalistaId)</td>
                                <td><span class="@Reglas.EstadoCss(r.Estado)">@Reglas.EstadoLabel(r.Estado)</span></td>
                                <td style="white-space:nowrap;font-size:13px;color:@(r.Estado == Estado.Ok && ot ? "var(--color-accent-700)" : late || r.Estado == Estado.Ok ? "var(--color-accent-900)" : "var(--color-neutral-700)");font-weight:@((r.Estado == Estado.Ok && !ot) || late ? "700" : "400")">
                                    @(r.Estado == Estado.Ok ? $"{(ot ? "A tiempo" : "Tardío")} · {Fechas.FmtDT(r.OkAt)}{Reglas.OkSuffix(r)}" : late ? "Vencido sin OK" : "—")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>
}

@code {
    HistoricoView? _v;
    Periodo _p = default!;
    List<Usuario> _analysts = [];
    Dictionary<int, string> _names = [];

    string Name(int? id) => id is { } i && _names.TryGetValue(i, out var n) ? n : "Sin asignar";
    static string P(double x) => x.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "%";

    protected override async Task LoadAsync()
    {
        _p = Ui.Periodo ??= Periodo.De(PeriodoModo.Semana, Cur.AddDays(-7));
        var users = await Users.ListAsync();
        _names = users.ToDictionary(u => u.Id, u => u.Nombre);
        _analysts = users.Where(u => u.Rol == Rol.Analista && u.Activo).ToList();
        _v = await Kpi.HistoricoAsync(Me, _p, Ui.AnFilter);
    }

    async Task SetPeriodo(Periodo p) { Ui.Periodo = p; await LoadAsync(); }
    async Task SetAn(int? a) { Ui.AnFilter = a; await LoadAsync(); }
    async Task PickBucket(HistBucket b) { if (b.Week is { } w) await SetPeriodo(Periodo.De(PeriodoModo.Semana, w)); }
}
