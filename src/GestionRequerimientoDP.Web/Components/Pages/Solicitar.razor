@page "/solicitar"
@attribute [Authorize(Policy = Policies.Comercial)]
@inherits AppPage
@inject ISolicitudService Sols

<PageTitle>Nueva solicitud · @AppInfo.Nombre</PageTitle>

<section data-screen-label="Nueva solicitud" class="stack" style="max-width:820px">
    <div>
        <h2 style="margin:0">Nueva solicitud a Operaciones</h2>
        <div class="sub">Tu solicitud llega al líder del equipo, que la planifica y asigna a un analista. Podrás seguir su estado en "Mis solicitudes".</div>
    </div>
    <div class="card" style="gap:var(--space-4);padding:var(--space-6)">
        <div class="field">
            <label>Unidad de Operaciones *</label>
            <Seg T="Equipo" Options="UnitOpts" Value="_d.Tipo" ValueChanged="SetTipo" Stretch="true" Style="display:flex" />
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:var(--space-3)">
            <div class="field"><label for="s-cli">Cliente *</label><input id="s-cli" class="form-control" @bind="_d.Cliente" placeholder="Ej. Banco Estado" /></div>
            <div class="field"><label for="s-job">Job *</label><input id="s-job" class="form-control" @bind="_d.Job" placeholder="26-000000-01-01" /></div>
            <div class="field" style="grid-column:1 / -1"><label for="s-pro">Proyecto / estudio *</label><input id="s-pro" class="form-control" @bind="_d.Proyecto" placeholder="Nombre del estudio" /></div>
            <div class="field">
                <label for="s-sl">SL *</label>
                <select id="s-sl" class="form-select" @bind="_d.SL">
                    @foreach (var b in Catalogos.SLS)
                    {
                        <option value="@b">@b</option>
                    }
                </select>
            </div>
            <div class="field">
                <label for="s-tec">Técnica *</label>
                <select id="s-tec" class="form-select" @bind="_d.Tecnica">
                    <option value="">Selecciona la técnica…</option>
                    @foreach (var c in Catalogos.CAMPOS)
                    {
                        <option value="@c">@c</option>
                    }
                </select>
            </div>
            <div class="field"><label for="s-fecha">Fecha requerida de entrega *</label><input id="s-fecha" class="form-control" type="date" min="@Fechas.Iso(Today)" @bind="_d.Fecha" /></div>
        </div>
        <div class="field">
            <label>@(_d.Tipo == Equipo.Script ? "Tipo de requerimiento" : "Entregables solicitados") * <span style="font-weight:400">(uno o más)</span></label>
            <div style="display:flex;flex-wrap:wrap;gap:var(--space-2)">
                @foreach (var e in Catalogos.EntregablesDe(_d.Tipo))
                {
                    var on = _d.Entregables.Contains(e);
                    <label class="chip @(on ? "on" : "")"><input type="checkbox" checked="@on" @onchange="() => Toggle(e)" />@(on ? "✓ " : "")@e</label>
                }
            </div>
        </div>
        <div class="field"><label for="s-desc">Descripción / instrucciones</label><input id="s-desc" class="form-control" @bind="_d.Descripcion" placeholder="Ej. Tablas con cruces por región, SPSS etiquetado" /></div>
        <div class="field"><label for="s-nota">Notas para Operaciones</label><textarea id="s-nota" class="form-control" @bind="_d.Nota" placeholder="Fecha estimada de entrega de materiales, contactos, prioridades…" style="min-height:70px"></textarea></div>
        <div style="font-size:13px;background:var(--teal-50);border-radius:6px;padding:var(--space-3)">Llegará a @_destino (líder de @Reglas.Tipo(_d.Tipo).Label). No se asigna analista automáticamente: el líder la planifica y asigna.</div>
        @if (_err != null)
        {
            <div class="err" role="alert">@_err</div>
        }
        <div style="display:flex;justify-content:flex-end;gap:var(--space-2)">
            <button class="btn btn-outline-secondary" @onclick="Reset">Limpiar</button>
            <button class="btn btn-primary" @onclick="Submit" disabled="@_busy">Enviar solicitud</button>
        </div>
    </div>
</section>

@code {
    static readonly IReadOnlyList<(Equipo, string)> UnitOpts = [(Equipo.Procesamiento, "Procesamiento de datos"), (Equipo.Codificacion, "Codificación"), (Equipo.Script, "Programación de script")];
    SolicitudInput _d = new();
    string _destino = "";
    string? _err;
    bool _busy;

    protected override ChangeKind[] ReloadOn => [ChangeKind.Usuarios];

    protected override async Task LoadAsync()
    {
        if (_d.Fecha is null) Reset();
        _destino = await Sols.DestinoAsync(_d.Tipo);
    }

    void Reset()
    {
        _d = new SolicitudInput { Fecha = Fechas.NextBiz(Fechas.NextBiz(Fechas.NextBiz(Today))) };
        _err = null;
    }

    async Task SetTipo(Equipo t)
    {
        _d.Tipo = t;
        _d.Entregables.Clear();
        _err = null;
        _destino = await Sols.DestinoAsync(t);
    }

    void Toggle(string e)
    {
        if (!_d.Entregables.Remove(e)) _d.Entregables.Add(e);
        _err = null;
    }

    async Task Submit()
    {
        if (_busy) return;
        _busy = true;
        try
        {
            var s = await Sols.EnviarAsync(Me, _d);
            Ui.Flash($"Solicitud {s.Codigo} enviada · aviso a {_destino}");
            Nav.NavigateTo("mis-solicitudes");
        }
        catch (ReglaException ex) { _err = ex.Message; }
        catch (PermisoException ex) { _err = ex.Message; }
        finally { _busy = false; }
    }
}
