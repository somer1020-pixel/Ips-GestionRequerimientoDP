@page "/notificaciones"
@attribute [Authorize(Policy = Policies.Lider)]
@inherits AppPage
@inject INotificationService Notif
@inject GestionRequerimientoDP.Infrastructure.Email.IEmailSender Mail
@inject IAuditoriaService Audit
@inject IUsuarioService Users

<PageTitle>Notificaciones · @AppInfo.Nombre</PageTitle>

<section data-screen-label="Notificaciones" class="stack">
    <div class="page-head">
        <div>
            <h2 style="margin:0">Notificaciones por correo</h2>
            <div class="sub">Registro de correos automáticos (cola de envío). Sin servidor SMTP configurado, los envíos se simulan y quedan registrados aquí.</div>
        </div>
        <button class="btn btn-outline-secondary" @onclick="RunOverdue"><Icon Name="activity" />Enviar recordatorios de atraso ahora</button>
    </div>
    <div class="card" style="gap:var(--space-2)">
        <div style="display:flex;align-items:center;gap:var(--space-3);flex-wrap:wrap">
            <span class="card-title">Servidor de correo</span>
            <span class="@(Mail.IsReal ? "be be-success" : "be be-warning")">@(Mail.IsReal ? "Envío real" : "Simulado")</span>
            <span style="font-size:13px;flex:1;min-width:240px">@Mail.Descripcion</span>
            <button class="btn btn-outline-secondary" @onclick="Probar" disabled="@_probando">@(_probando ? "Enviando…" : $"Enviar correo de prueba a {_miCorreo}")</button>
        </div>
        @if (_prueba is { } pr)
        {
            <div role="status" style="font-size:13px;font-weight:500;color:@(pr.Ok ? "var(--teal-text, #0b7a78)" : "var(--color-accent-900)")">@pr.Mensaje</div>
        }
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:var(--space-6);padding:6px">
        @foreach (var (title, on, desc) in Rules)
        {
            <div class="card blueprint">
                <div style="display:flex;justify-content:space-between;align-items:center;gap:8px"><span class="card-title">@title</span><span class="@(on ? "tag tag-accent" : "tag tag-neutral")">@(on ? "Activa" : "Desactivada")</span></div>
                <p class="card-body" style="opacity:1;color:var(--color-neutral-800)">@desc</p>
            </div>
        }
    </div>
    <div class="scroll-x">
        <table class="table">
            <thead><tr><th>Enviado</th><th>Tipo</th><th>Para</th><th>Asunto</th><th>Estado</th></tr></thead>
            <tbody>
                @foreach (var m in _mails)
                {
                    <tr @key="m.Id" @onclick="() => _open = _open == m.Id ? null : m.Id" style="cursor:pointer">
                        <td style="white-space:nowrap;font-size:13px">@Fechas.FmtDT(m.SentAt ?? m.CreatedAt)</td>
                        <td><span class="@KindCss(m.Kind)">@KindLabel(m.Kind)</span></td>
                        <td style="font-size:13px">@string.Join(", ", m.ToList)</td>
                        <td>@m.Subject</td>
                        <td style="font-size:13px;white-space:nowrap" title="@m.Error">@StatusLabel(m)</td>
                    </tr>
                    @if (_open == m.Id)
                    {
                        <tr><td colspan="5" style="background:var(--color-neutral-100)">
                            <div style="font-size:12px;color:var(--color-neutral-700);padding-bottom:6px">Para: @string.Join(", ", m.ToList) · CC: @(m.CcList.Any() ? string.Join(", ", m.CcList) : "—")@(string.IsNullOrEmpty(m.Error) ? "" : " · " + m.Error)</div>
                            <pre style="margin:0;font-family:var(--font-body);font-size:13px;white-space:pre-wrap;line-height:1.5">@m.Body</pre>
                        </td></tr>
                    }
                }
            </tbody>
        </table>
        @if (Loaded && _mails.Count == 0)
        {
            <div class="empty">Aún no se han enviado correos.</div>
        }
    </div>
</section>

@code {
    List<Notificacion> _mails = [];
    int? _open;
    bool _probando;
    string _miCorreo = "";
    (bool Ok, string Mensaje)? _prueba;

    /// <summary>Envía un correo directo (sin pasar por la cola) y muestra el error exacto del servidor si falla.</summary>
    async Task Probar()
    {
        if (!Me.EsLider || _probando || _miCorreo.Length == 0) return;
        _probando = true; _prueba = null;
        try
        {
            await Mail.SendAsync([_miCorreo], [], $"[{AppInfo.Nombre}] Correo de prueba",
                $"Correo de prueba enviado por {Me.Nombre} desde Notificaciones.\n\nServidor: {Mail.Descripcion}\n\nSi lo recibes, los avisos y la recuperación de contraseña pueden salir por este servidor.", default);
            _prueba = Mail.IsReal ? (true, $"Enviado a {_miCorreo}. Si no llega en unos minutos, revisa la carpeta de spam o pide a TI revisar el relay (que acepte el remitente y esta IP).")
                                  : (false, "No se envió: el correo está simulado porque no hay servidor SMTP configurado (Smtp:Host).");
            await Audit.RegistrarAsync(_miCorreo, Mail.IsReal ? "CORREO_PRUEBA_OK" : "CORREO_PRUEBA_SIMULADO", "Admin", "", Mail.Descripcion);
        }
        catch (Exception ex)
        {
            var detalle = ex.InnerException is { } inner ? $"{ex.Message} ({inner.Message})" : ex.Message;
            _prueba = (false, $"El servidor de correo rechazó el envío: {detalle}");
            await Audit.RegistrarAsync(_miCorreo, "CORREO_PRUEBA_ERROR", "Admin", "", $"{ex.GetType().Name}: {detalle}");
        }
        finally { _probando = false; }
    }

    protected override ChangeKind[] ReloadOn => [ChangeKind.Notificaciones];

    IEnumerable<(string, bool, string)> Rules
    {
        get
        {
            var o = Opts.CurrentValue;
            yield return ("Asignación", o.NotifyAssign, "Al asignar o reasignar (manual, balanceo, importación, nuevo script) se envía un correo al analista con el detalle. Las acciones masivas envían un solo correo por analista.");
            yield return ("Atraso sin gestión", o.NotifyOverdue, $"Revisión diaria (09:00, hora de Chile): si un requerimiento pasó su día de entrega sin OK y sigue pendiente o lleva {o.StaleDays}+ días sin actualización, se avisa al analista con copia al líder (máximo un aviso por día).");
            yield return ("Nueva solicitud comercial", true, "Cuando un área comercial envía una solicitud, se avisa al líder del equipo correspondiente (según \"Equipos a cargo\"; si no hay, a todos los líderes) con copia al solicitante. No se asigna analista.");
        }
    }

    static string KindLabel(NotificacionKind k) => k switch { NotificacionKind.Atraso => "Atraso sin gestión", NotificacionKind.Solicitud => "Nueva solicitud", NotificacionKind.Acceso => "Acceso", _ => "Asignación" };
    static string KindCss(NotificacionKind k) => k switch { NotificacionKind.Atraso => "be be-danger", NotificacionKind.Solicitud => "be be-warning", NotificacionKind.Acceso => "be be-info", _ => "be be-neutral" };
    static string StatusLabel(Notificacion m) => m.Status switch
    {
        NotificacionStatus.Enviado => m.Error.Length > 0 ? "Enviado (simulado)" : "Enviado",
        NotificacionStatus.Error => "Error · reintentando",
        NotificacionStatus.Omitido => "Omitido",
        _ => "En cola",
    };

    protected override async Task LoadAsync()
    {
        _mails = await Notif.ListAsync();
        if (_miCorreo.Length == 0) _miCorreo = (await Users.GetAsync(Me.Id))?.Email ?? "";
    }

    Task RunOverdue() => Run(async () =>
    {
        var n = await Notif.CheckOverdueAsync(true);
        Ui.Flash(n > 0 ? $"{n} correo(s) de atraso enviados" : "No hay requerimientos atrasados sin gestión");
        await LoadAsync();
    });
}
