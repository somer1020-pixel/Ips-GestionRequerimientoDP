@page "/cuenta/ingresar"
@layout PublicLayout
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@inject IUsuarioService Users
@inject Microsoft.Extensions.Options.IOptionsMonitor<AuthOptions> AuthOpts
@inject Microsoft.Extensions.Options.IOptionsMonitor<SsoOptions> SsoOpts
@inject NavigationManager Nav

<PageTitle>Ingresar · @AppInfo.Nombre</PageTitle>

<div data-screen-label="Login" style="flex:1;display:grid;place-items:center;padding:var(--space-8) var(--space-4)">
    <div style="width:min(440px,100%);display:flex;flex-direction:column;gap:var(--space-6)">
        <div style="display:flex;flex-direction:column;border-radius:6px;overflow:hidden;border:1px solid var(--border);background:var(--surface-200)">
            <div style="background:var(--navy);color:#fff;padding:20px;display:flex;align-items:center;gap:12px">
                <span class="brand-mark" style="width:36px;height:36px;font-size:14px">@AppInfo.Marca</span>
                <div style="display:flex;flex-direction:column;line-height:1.2">
                    <span style="font-weight:600;font-size:20px">@AppInfo.Nombre</span>
                    <span style="font-size:13px;opacity:.8">@AppInfo.Subtitulo</span>
                </div>
            </div>
            @if (AutoSso)
            {
                @* Red interna: se intenta la cuenta corporativa sin pedir contraseña (app.js; vuelve al formulario en InPrivate o si no responde). *@
                <div id="sso-auto" data-sso-url="@SsoUrl" style="display:flex;flex-direction:column;align-items:center;gap:var(--space-3);padding:var(--space-8) var(--space-6);text-align:center">
                    <span class="spinner-border" role="status" style="width:2.5rem;height:2.5rem;color:var(--teal)"></span>
                    <h3 style="margin:0;font-size:18px">Detectando tu cuenta corporativa…</h3>
                    <span class="sub">Si estás en la red de la empresa o en la VPN, ingresas sin escribir tu contraseña.</span>
                    <a class="btn btn-outline-secondary" href="cuenta/ingresar?manual=1" data-enhance-nav="false" style="font-size:13px">Ingresar con correo y contraseña</a>
                </div>
            }
            <form id="login-form" class="@(AutoSso ? "d-none" : "")" method="post" action="cuenta/login" style="display:flex;flex-direction:column;gap:var(--space-4);padding:var(--space-6)">
                <AntiforgeryToken />
                <h3 style="margin:0">Ingresar</h3>
                @if (Sso.Enabled)
                {
                    <a class="btn btn-outline-secondary btn-block" href="@SsoUrl" data-enhance-nav="false" style="min-height:40px;margin-top:0">Ingresar con mi cuenta corporativa (Windows)</a>
                    <div class="sub" style="display:flex;align-items:center;gap:var(--space-2)"><span style="flex:1;height:1px;background:var(--border)"></span>o con correo y contraseña<span style="flex:1;height:1px;background:var(--border)"></span></div>
                }
                <input type="hidden" name="returnUrl" value="@SsoRules.SafeReturnUrl(ReturnUrl, HttpContext.Request.PathBase)" />
                <div class="field"><label for="email">Correo o RUT</label><input id="email" name="email" class="form-control" type="text" value="@Email" placeholder="nombre@empresa.cl o 12.345.678-9" required autocomplete="username"></div>
                <div class="field"><label for="password">Contraseña</label><input id="password" name="password" class="form-control" type="password" placeholder="••••••••" autocomplete="current-password"></div>
                @if (!string.IsNullOrEmpty(Ok))
                {
                    <div role="status" style="font-size:13px;color:var(--success);background:var(--success-50);border-radius:6px;padding:var(--space-2) var(--space-3)">@Ok</div>
                }
                @if (!string.IsNullOrEmpty(Error))
                {
                    <div role="alert" style="font-size:13px;color:var(--color-accent-900);font-weight:500">@Error</div>
                }
                <button class="btn btn-primary btn-block" type="submit" style="min-height:40px">Ingresar</button>
                <div style="display:flex;justify-content:space-between;gap:var(--space-3);flex-wrap:wrap;font-size:13px">
                    <a href="cuenta/recuperar">¿Olvidaste tu contraseña?</a>
                    @if (AuthOpts.CurrentValue.RegistroHabilitado)
                    {
                        <a href="cuenta/registro">Solicitar acceso</a>
                    }
                </div>
                @if (!Demo)
                {
                    <div class="note">Usa tu correo corporativo y contraseña. Si no tienes acceso, pídelo al líder de Operaciones.</div>
                }
            </form>
        </div>
        @if (Demo)
        {
            <div style="display:flex;flex-direction:column;gap:var(--space-2)">
                <span class="card-kicker" style="color:var(--color-accent-700)">Accesos de demostración</span>
                @foreach (var g in Groups)
                {
                    if (g.Users.Count == 0) continue;
                    <div style="display:flex;flex-direction:column;gap:2px">
                        <span style="font-size:12px;color:var(--color-neutral-700);padding-top:var(--space-2)">@g.Label</span>
                        <div style="display:flex;flex-wrap:wrap;gap:var(--space-2)">
                            @foreach (var u in g.Users)
                            {
                                <form method="post" action="cuenta/login" style="margin:0">
                                    <AntiforgeryToken />
                                    <input type="hidden" name="email" value="@u.Email" />
                                    <input type="hidden" name="demo" value="1" />
                                    <button class="btn btn-outline-secondary" type="submit" style="font-size:13px">@u.Nombre</button>
                                </form>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        <a class="btn btn-ghost" href="consulta" style="align-self:flex-start;font-size:14px"><Icon Name="search" Size="15" />¿No participas de la gestión? Consulta el estado de un requerimiento</a>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? Error { get; set; }
    [SupplyParameterFromQuery] public string? Email { get; set; }
    [SupplyParameterFromQuery] public string? Ok { get; set; }
    [SupplyParameterFromQuery(Name = "manual")] public string? Manual { get; set; }
    [SupplyParameterFromQuery(Name = "external")] public string? External { get; set; }
    [SupplyParameterFromQuery(Name = "ReturnUrl")] public string? ReturnUrl { get; set; }
    [CascadingParameter] public HttpContext HttpContext { get; set; } = default!;

    bool Demo => AuthOpts.CurrentValue.DemoMode;
    SsoOptions Sso => SsoOpts.CurrentValue;
    string SsoUrl => $"{(string.IsNullOrWhiteSpace(Sso.InternalHost) ? HttpContext.Request.PathBase.ToString() : Sso.InternalHost.TrimEnd('/'))}/cuenta/sso?returnUrl={Uri.EscapeDataString(SsoRules.SafeReturnUrl(ReturnUrl, HttpContext.Request.PathBase))}";

    /// <summary>Intento automático: SSO activo, red interna, sin error y sin pedir el formulario (?manual=1 / ?external=1).</summary>
    bool AutoSso => Sso.Enabled && Sso.AutoRedirect && Manual is null && External is null && string.IsNullOrEmpty(Error)
                    && SsoRules.IsInternal(SsoRules.ClientIp(HttpContext, Sso), Sso);
    List<(string Label, List<Usuario> Users)> Groups = [];

    protected override async Task OnInitializedAsync()
    {
        if (HttpContext.User.Identity?.IsAuthenticated == true)
        {
            Nav.NavigateTo(HttpContext.User.IsInRole(nameof(Rol.Comercial)) ? "solicitar" : "./");
            return;
        }
        if (!Demo) return;
        var act = (await Users.ListAsync()).Where(u => u.Activo).ToList();
        Groups =
        [
            ("Líderes de equipo", act.Where(u => u.Rol == Rol.Lider).ToList()),
            ("Analistas de procesamiento (DP)", act.Where(u => u.Rol == Rol.Analista && u.Equipos.Count == 1 && u.Tiene(Equipo.Procesamiento)).ToList()),
            ("Analistas de scripting", act.Where(u => u.Rol == Rol.Analista && u.Equipos.Count == 1 && u.Tiene(Equipo.Script)).ToList()),
            ("Analistas de codificación", act.Where(u => u.Rol == Rol.Analista && u.Equipos.Count == 1 && u.Tiene(Equipo.Codificacion)).ToList()),
            ("Analistas en más de un equipo", act.Where(u => u.Rol == Rol.Analista && u.Equipos.Count > 1).ToList()),
            ("Áreas comerciales", act.Where(u => u.Rol == Rol.Comercial).ToList()),
        ];
    }
}
