<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- forwardWindowsAuthToken: con Windows Authentication habilitada en IIS, la app recibe la cuenta corporativa (SSO). -->
      <aspNetCore processPath="dotnet" arguments=".\GestionRequerimientoDP.Web.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess" forwardWindowsAuthToken="true">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
      <!-- SSO: deja pasar la página HTML del 401 de /cuenta/sso (vuelve al ingreso manual si el navegador no envía la cuenta Windows). -->
      <httpErrors existingResponse="PassThrough" />
      <!-- Blazor Server usa WebSockets: habilita la característica "Protocolo WebSocket" en IIS. -->
      <webSocket enabled="true" />
      <security>
        <!-- Sin removeServerHeader: solo existe en IIS 10 y en IIS 8.5 (Windows Server 2012 R2) provoca el error 500.19. -->
        <requestFiltering>
          <requestLimits maxAllowedContentLength="31457280" />
        </requestFiltering>
      </security>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
          <add name="X-Content-Type-Options" value="nosniff" />
          <add name="Referrer-Policy" value="same-origin" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
