<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\GestionRequerimientoDP.Web.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
      <!-- SSO: deja pasar la página HTML del 401 de /cuenta/sso (vuelve al ingreso manual si el navegador no envía la cuenta Windows). -->
      <httpErrors existingResponse="PassThrough" />
    </system.webServer>
  </location>
</configuration>
